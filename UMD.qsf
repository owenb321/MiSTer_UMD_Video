#     field siting -- the neighbour row fetched with the line, four neighbour RAMs; docs/display.md S13): at the
#     pinned SEED 5 PASS clk_dec 87.87/88.89, clk_mem 96.66/97.36, no negative slack on a core clock (pll_hdmi only). ALM 41,130 (98 %,
#     the packing estimate) -- combinational ALUTs 62,298 -> 62,722 (+424), registers 51,592. RAM 503 -> 507 (+4,
#     as planned), DSP 92. UMD_chromafld_20261012_1940.rbf, clean tree. No sweep (the fit passes).
#   2026-10-13 RELEASE v0.1.0 (main 9cfd145, the release commit: CORE_VERSION v0.1.0, BUILD_DATE 261013 --
#     the netlist of chroma-field plus the version string): build_release.sh --release at the pinned SEED 5
#     PASS clk_dec 89.17/88.18, clk_mem 95.72/95.11, gates PASS (lint, canary, fmax at both corners). ALM 41,109
#     (98 %), registers 51,672, RAM 507, DSP 92. releases/UMD_20261013.rbf (sha256 in its .json); the UMD Main
#     MiSTer_UMD from the same commit (Main_MiSTer 7317947, host_proto 1).
#     REBUILT at 2dfb9e1 (the install text's fix, tools/package_release.sh: no netlist change, the same
#     BUILD_DATE): the .rbf bit-identical (sha256 6c218b09..., the smoke-tested file), the UMD Main too
#     (3a5af4c4...). 2dfb9e1 is the shipped release commit; the draft targets it.

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "22:30:00  SEPTEMBER 22, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

