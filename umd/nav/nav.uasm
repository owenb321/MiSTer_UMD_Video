; umd/nav/nav.uasm -- the navigation engine's program: umd_reader.sv's walk and navigation
; (docs/nav_engine.md S1, S7). Assembled and emulated by tools/nav_isa.py.
;
; Every label named S_* is the RTL state of the same name (umd/umd_reader.sv), so the two
; read side by side; the verdicts, the field offsets and the 33-bit "a carry is out of
; bounds" guards are the RTL's, cited there. What the hardware keeps (the pump, the take, the
; restart) is in docs/nav_engine.md S7.
;
; Conventions: r0 = 0. r15 = the current file's size (a file-relative fetch at or past it is
; the file's out-of-bounds verdict, S_OOB). r1-r14 are scratch: a value that must live across
; a call or a file load is kept in RAM (V_*). The reader's outputs (O_*) are write-only: the
; program keeps its own copy of whatever it needs again.
;
; Wide values: a 48-bit PTS is a pair {hi16, lo32}; a 64-bit duration or mark key {hi32, lo32}.

; ---- the RTL's codes -------------------------------------------------------------------------
.equ E_SMALL 1
.equ E_NOT_ISO 2
.equ E_BADDIR 3
.equ E_NO_UMDV 4
.equ E_NO_PL 5
.equ E_PL 6
.equ E_NO_CLP 7
.equ E_CLP 8
.equ E_NO_MPS 9
.equ E_INTERLEAVE 10
.equ E_EXTENT 11
.equ E_BARE 12
.equ NAV_SEEK 1
.equ NAV_CHAP 2
.equ NAV_PLAY 3
.equ NAV_TIME 4
.equ NE_NONE 0
.equ NE_ITEM 1
.equ NE_MARKS 2
.equ NE_OOB 3
.equ NE_NOMAP 4
.equ NE_PAST 5
.equ NE_WIDE 6
.equ NE_OP 7
; state_o codes (telemetry, the bench's [pick] / [hold])
.equ ST_IDLE 0
.equ ST_INIT 1
.equ ST_WALK 9
.equ ST_ITEM 27
.equ ST_ITEM2 28
.equ ST_STREAM 37
.equ ST_DRAIN 38
.equ ST_DONE 39
.equ ST_ERROR 40
; cur_file
.equ FILE_SFO 0
.equ FILE_PL 1
.equ FILE_CLP 2
.equ FILE_MRK 3

; ---- RAM (32-bit words) ------------------------------------------------------------------------
.equ V_TOTAL 0          ; image sectors
.equ V_UV_LBA 1
.equ V_UV_LEN 2
.equ V_PL_LBA 3
.equ V_PL_SIZE 4
.equ V_CUR_FILE 5
.equ V_FD_LBA 6         ; the directory the finder searches
.equ V_FD_LEN 7
.equ V_TLEN 8
.equ V_TDIR 9
.equ V_FD_FOUND 10
.equ V_FD_EXT 11
.equ V_FD_SIZE 12
.equ V_FD_FLAGS 13
.equ V_FD_RL 14
.equ V_DIR_LBA 15
.equ V_DIR_REMAIN 16
.equ V_P 17
.equ V_FLAGS 18         ; O_FLAGS' copy
.equ V_BARE 19
.equ V_VD_LBA 20
.equ V_SFO_KOFF 21
.equ V_SFO_DOFF 22
.equ V_SFO_N 23
.equ V_SFO_I 24
.equ V_SFO_DO 25
.equ V_TC_K 26
.equ V_TLEN_OUT 27      ; title_len
.equ V_N_PL 28
.equ V_PL_K 29
.equ V_PL_P 30
.equ V_PL_NEXT 31
.equ V_PL_MK 32
.equ V_PL_MK_C 33
.equ V_IT_N 34
.equ V_IT_J 35
.equ V_IT_Q 36
.equ V_IT_Q0 37
.equ V_DUR_HI 38
.equ V_DUR_LO 39
.equ V_BEST_VALID 40
.equ V_BEST_DUR_HI 41
.equ V_BEST_DUR_LO 42
.equ V_BEST_Q 43
.equ V_BEST_N 44
.equ V_BEST_MK 45
.equ V_BEST_MK_C 46
.equ V_PL_FORCE 47
.equ V_PL_FK 48
.equ V_ITEM_Q 49
.equ V_ITEM_NEXT 50
.equ V_ITEM_IDX 51
.equ V_CL_LEN 52
.equ V_IN_HI 53
.equ V_IN_LO 54
.equ V_OUT_HI 55
.equ V_OUT_LO 56
.equ V_BASE_HI 57       ; base_acc
.equ V_BASE_LO 58
.equ V_SI_OFF 59
.equ V_EPMAP 60
.equ V_ST_N 61
.equ V_ST_I 62
.equ V_ST_O 63
.equ V_NVID 64
.equ V_NUNK 65
.equ V_AUD 66
.equ V_SUB 67
.equ V_VATTR 68
.equ V_SK_ACT 69
.equ V_SK_TM 70
.equ V_SK_HI 71         ; sk_pts
.equ V_SK_LO 72
.equ V_SK_ITEM 73
.equ V_NAV_ERR 74
.equ V_EP_FLAGS 75
.equ V_STOP_V 76
.equ V_STOP_SEC 77
.equ V_EP_NM 78
.equ V_EP_MI 79
.equ V_VM_N 80
.equ V_VM_LO 81         ; vm_base, 33 bits
.equ V_VM_C 82
.equ V_LK_LO 83
.equ V_LK_HI 84
.equ V_LK_STOP 85
.equ V_LK_IDX 86
.equ V_T_HI 87          ; the start lookup's target (lk_start_t)
.equ V_T_LO 88
.equ V_EP_IDX 89
.equ V_EP_PTS 90
.equ V_EP_SEC 91
.equ V_SK_SKIP 92
.equ V_CLIP_LIM 93
.equ V_CLIP_LEFT 94
.equ V_STREAMING 95
.equ V_RET 96           ; where a NAV_CHAP returns (1 stream, 2 drain, 3 done)
.equ V_MK_N 97
.equ V_MK_I 98
.equ V_MK_O 99
.equ V_MK_OC 100
.equ V_Q2 101           ; q_key1, 65 bits
.equ V_QHI 102
.equ V_QLO 103
.equ V_CH_RANK 104
.equ V_CH_COUNT 105
.equ V_CH_VALID 106
.equ V_CUR_HI 107
.equ V_CUR_LO 108
.equ V_PREV_HI 109
.equ V_PREV_LO 110
.equ V_NEXT_HI 111
.equ V_NEXT_LO 112
.equ V_PAUSED 113
.equ V_IT_DHI 114       ; the item record's OUT - IN (it_delta)
.equ V_IT_DLO 115
.equ V_FD_NSEC 116
.equ V_TNAME 128        ; 14 words, a byte each
.equ V_CN 144           ; 8 words: the clip name's bytes

; =============================================================================================
; vectors: start -> 0, stop -> 1 (a hardware restart: docs/nav_engine.md S7); a reset is a stop (pc 1, fj#64)
                jmp START
                jmp STOP

; ---- the mount's constants (umd_reader.sv's start / stop block) ------------------------------
INIT:           st r0, V_SK_ACT[r0]
                st r0, V_SK_TM[r0]
                st r0, V_PL_FORCE[r0]
                st r0, V_EP_FLAGS[r0]
                st r0, O_EP_FLAGS[r0]
                st r0, V_CLIP_LIM[r0]
                st r0, V_SK_SKIP[r0]
                st r0, V_STREAMING[r0]
                st r0, V_FLAGS[r0]
                st r0, O_FLAGS[r0]
                st r0, V_BARE[r0]
                st r0, O_BARE[r0]
                st r0, V_TLEN_OUT[r0]
                st r0, O_TITLE_LEN[r0]
                st r0, O_ITEM_BASE_HI[r0]
                st r0, O_ITEM_BASE_LO[r0]
                st r0, V_BASE_HI[r0]
                st r0, V_BASE_LO[r0]
                st r0, O_AUD_PRESENT[r0]
                st r0, O_SUB_PRESENT[r0]
                st r0, O_NAV_READY[r0]
                ; P8: what a bare file plays with (one item of one playlist, IN 90000, OUT at the
                ; end of time); an image's walk overwrites every one before it is read
                li r1, 1
                st r1, V_N_PL[r0]
                st r1, O_N_PLAYLISTS[r0]
                st r0, O_MAIN_PL[r0]
                st r1, V_BEST_N[r0]
                st r1, O_ACC_ITEMS[r0]
                st r1, O_N_ITEMS[r0]
                st r0, V_ITEM_IDX[r0]
                st r0, O_ITEM_IDX[r0]
                li r1, 90000
                st r0, V_IN_HI[r0]
                st r1, V_IN_LO[r0]
                st r0, O_ITEM_IN_HI[r0]
                st r1, O_ITEM_IN_LO[r0]
                li r1, 0xFFFF
                li r2, 0xFFFFFFFF
                st r1, V_OUT_HI[r0]
                st r2, V_OUT_LO[r0]
                st r1, O_ITEM_OUT_HI[r0]
                st r2, O_ITEM_OUT_LO[r0]
                st r0, O_PL_DUR_HI[r0]
                st r0, O_PL_DUR_LO[r0]
                ret

STOP:           call INIT
                li r1, ST_IDLE
                st r1, O_STATE[r0]
STOP_HALT:      wait 0
                jmp STOP_HALT

; ---- errors and the out-of-bounds verdict ------------------------------------------------------
; r1 = the error code. The walk stops; only a restart leaves.
ERR:            st r1, O_ERR[r0]
                li r1, ST_ERROR
                st r1, O_STATE[r0]
                st r0, O_NAV_READY[r0]
ERR_HALT:       wait 0
                jmp ERR_HALT

E_BADDIR_:      li r1, E_BADDIR
                jmp ERR
E_PL_:          li r1, E_PL
                jmp ERR
E_CLP_:         li r1, E_CLP
                jmp ERR
E_NO_CLP_:      li r1, E_NO_CLP
                jmp ERR

; S_OOB: a fetch at or past the file's size, per file
S_OOB:          ld r1, V_CUR_FILE[r0]
                beqi r1, FILE_SFO, SFO_WARN
                beqi r1, FILE_PL, E_PL_
                beqi r1, FILE_MRK, MK_OOB
                jmp E_CLP_

; ---- helpers -------------------------------------------------------------------------------------
; SETFILE: r1 = LBA, r2 = size -> F_LBA, F_LAST = LBA + sectors - 1, r15 = size
SETFILE:        st r1, O_F_LBA[r0]
                shr r3, r2, 11
                and r4, r2, 2047
                sne r4, r4, r0
                add r3, r3, r4
                add r3, r3, r1
                sub r3, r3, 1
                st r3, O_F_LAST[r0]
                mov r15, r2
                ret

; SETDIR: r1 = a directory sector: it alone (a directory record never crosses; past it reads 0)
SETDIR:         st r1, O_F_LBA[r0]
                st r1, O_F_LAST[r0]
                ret

; SETNAME: r1..r3 = up to 12 name bytes packed big-endian, r4 = length, r5 = 1 for a directory
SETNAME:        st r4, V_TLEN[r0]
                st r5, V_TDIR[r0]
                li r6, V_TNAME
                mov r7, r1
                call SN_WORD
                mov r7, r2
                call SN_WORD
                mov r7, r3
                call SN_WORD
                ret
SN_WORD:        shr r8, r7, 24
                st r8, 0[r6]
                shr r8, r7, 16
                and r8, r8, 255
                st r8, 1[r6]
                shr r8, r7, 8
                and r8, r8, 255
                st r8, 2[r6]
                and r8, r7, 255
                st r8, 3[r6]
                add r6, r6, 4
                ret

; CLIPNAME: tname = the item's clip name + "." + r1 (3 bytes packed: "CLP" or "MPS")
CLIPNAME:       ld r2, V_CL_LEN[r0]
                li r3, 0
CN_LOOP:        beq r3, r2, CN_EXT
                ld r4, V_CN[r3]
                st r4, V_TNAME[r3]
                add r3, r3, 1
                jmp CN_LOOP
CN_EXT:         li r4, 46                       ; "."
                st r4, V_TNAME[r3]
                shr r4, r1, 16
                st r4, V_TNAME+1[r3]
                shr r4, r1, 8
                and r4, r4, 255
                st r4, V_TNAME+2[r3]
                and r4, r1, 255
                st r4, V_TNAME+3[r3]
                add r2, r2, 4
                st r2, V_TLEN[r0]
                st r0, V_TDIR[r0]
                ret

; DELTA48: r1:r2 = IN {hi, lo}, r3:r4 = OUT -> r5:r6 = OUT - IN where OUT > IN, else 0 (it_delta)
DELTA48:        sub r7, r2, r4
                sbc r7, r1, r3                  ; C: IN < OUT
                bcs D48_POS
                li r5, 0
                li r6, 0
                ret
D48_POS:        sub r6, r4, r2
                sbc r5, r3, r1
                ret

; BASE_ADD: base_acc += r5:r6 (it_delta), saturating at 48 bits (base_nx)
BASE_ADD:       ld r7, V_BASE_HI[r0]
                ld r8, V_BASE_LO[r0]
                add r8, r8, r6
                adc r7, r7, r5
                shr r9, r7, 16
                beqi r9, 0, BA_ST
                li r7, 0xFFFF
                li r8, 0xFFFFFFFF
BA_ST:          st r7, V_BASE_HI[r0]
                st r8, V_BASE_LO[r0]
                ret

; ---- the directory finder (S_FIND / S_FIND_REC) -------------------------------------------------
; Searches (V_FD_LBA, V_FD_LEN) for the name in V_TNAME / V_TLEN / V_TDIR. Returns with
; V_FD_FOUND, and the record's extent, size, flags and length. FIND_CONT resumes past the
; found record (a multi-extent .MPS: S_MPS_NEXT).
FIND:           st r0, V_FD_FOUND[r0]
                ld r1, V_FD_LBA[r0]
                ld r2, V_FD_LEN[r0]
                st r1, V_DIR_LBA[r0]
                st r2, V_DIR_REMAIN[r0]
                st r0, V_P[r0]
                beqi r2, 0, FIND_RET
                jmp FIND_SEC
FIND_CONT:      st r0, V_FD_FOUND[r0]
                ld r1, V_P[r0]
                ld r2, V_FD_RL[r0]
                add r1, r1, r2
                st r1, V_P[r0]
FIND_SEC:       ld r1, V_DIR_LBA[r0]
                call SETDIR
FIND_REC:       ld r10, V_P[r0]
                li r1, 2048
                bgeu r10, r1, FIND_PAD
                lbf r11, 0[r10], 1              ; rec_len_b
                beqi r11, 0, FIND_PAD
                bltui r11, 34, E_BADDIR_
                add r1, r10, r11
                li r2, 2048
                bltu r2, r1, E_BADDIR_          ; rec_end > 2048
                lbf r1, 25[r10], 1              ; rec_flags
                shr r1, r1, 1
                and r1, r1, 1                   ; rec_is_dir
                ld r2, V_TDIR[r0]
                bne r1, r2, FIND_NEXT
                lbf r12, 32[r10], 1             ; rec_namelen
                ld r13, V_TLEN[r0]
                bltu r12, r13, FIND_NEXT
                li r14, 0
FIND_CMP:       beq r14, r13, FIND_LEN
                add r1, r10, r14
                lbf r2, 33[r1], 1
                ld r3, V_TNAME[r14]
                bne r2, r3, FIND_NEXT
                add r14, r14, 1
                jmp FIND_CMP
FIND_LEN:       beq r12, r13, FIND_HIT
                add r1, r10, r13
                lbf r2, 33[r1], 1               ; name_after: a ";N" version suffix
                bnei r2, 59, FIND_NEXT
FIND_HIT:       li r1, 1
                st r1, V_FD_FOUND[r0]
                lbl r1, 2[r10], 4
                st r1, V_FD_EXT[r0]
                lbl r1, 10[r10], 4
                st r1, V_FD_SIZE[r0]
                lbf r1, 25[r10], 1
                st r1, V_FD_FLAGS[r0]
                st r11, V_FD_RL[r0]
                ld r1, V_TDIR[r0]
                bnei r1, 0, FIND_RET
                lbf r1, 26[r10], 2              ; file unit size, interleave gap
                bnei r1, 0, FIND_INTL
FIND_RET:       ret
FIND_INTL:      li r1, E_INTERLEAVE
                jmp ERR
FIND_NEXT:      add r10, r10, r11
                st r10, V_P[r0]
                jmp FIND_REC
FIND_PAD:       ld r1, V_DIR_REMAIN[r0]
                li r2, 2048
                bgeu r2, r1, FIND_RET           ; not found
                sub r1, r1, r2
                st r1, V_DIR_REMAIN[r0]
                ld r1, V_DIR_LBA[r0]
                add r1, r1, 1
                st r1, V_DIR_LBA[r0]
                st r0, V_P[r0]
                jmp FIND_SEC

; =============================================================================================
; S_INIT / S_SNIFF: sector 0 -- a bare .MPS, a .PMF, or an image (P8)
START:          call INIT
                li r1, ST_INIT
                st r1, O_STATE[r0]
                ld r1, I_FSIZE_LO[r0]
                ld r2, I_FSIZE_HI[r0]
                shr r3, r1, 11
                shl r4, r2, 21
                or r3, r3, r4
                and r4, r1, 2047
                sne r4, r4, r0
                add r3, r3, r4
                st r3, V_TOTAL[r0]
                li r1, 0
                call SETDIR                     ; sector 0
                lbf r5, 0[r0], 4
                lbf r6, 8[r0], 4                ; a PSMF's stream offset
                lbf r7, 12[r0], 4               ; ... and size
                li r8, 0x000001BA
                seq r8, r5, r8                  ; pack_magic
                li r9, 0x50534D46
                seq r9, r5, r9                  ; psmf_magic
                or r10, r8, r9
                beqi r10, 0, SNIFF_IMG
                ld r1, I_FSIZE_HI[r0]
                bnei r1, 0, SNIFF_BARE_E        ; file_huge
                beqi r9, 0, SNIFF_BARE
                ; pmf_bad: the offset 0, unaligned, or its sector outside the file
                beqi r6, 0, SNIFF_BARE_E
                and r1, r6, 2047
                bnei r1, 0, SNIFF_BARE_E
                shr r1, r6, 11
                ld r2, V_TOTAL[r0]
                bgeu r1, r2, SNIFF_BARE_E
SNIFF_BARE:     ; the whole file as one extent into S_MPS
                li r1, 2
                sub r1, r1, r8                  ; 1 a bare .MPS, 2 a .PMF
                st r1, V_BARE[r0]
                st r1, O_BARE[r0]
                beqi r9, 0, SB_NOWARN
                add r1, r6, r7                  ; pmf_mis: offset + size != the file's size (33 bits)
                bcs SB_WARN
                ld r2, I_FSIZE_LO[r0]
                beq r1, r2, SB_NOWARN
SB_WARN:        li r1, FL_PMF_WARN
                st r1, V_FLAGS[r0]
                st r1, O_FLAGS[r0]
SB_NOWARN:      st r0, V_FD_EXT[r0]
                ld r1, I_FSIZE_LO[r0]
                st r1, V_FD_SIZE[r0]
                st r0, V_FD_FLAGS[r0]
                li r1, 1
                st r1, V_FD_FOUND[r0]
                li r1, 0
                beqi r9, 0, SB_SKIP
                shr r1, r6, 11
SB_SKIP:        st r1, V_SK_SKIP[r0]
                st r9, V_CLIP_LIM[r0]
                shr r1, r7, 11                  ; pmf_n_hdr: the header's size in sectors
                and r2, r7, 2047
                sne r2, r2, r0
                add r1, r1, r2
                st r1, V_CLIP_LEFT[r0]
                st r9, P_CLIP_LIM[r0]
                st r1, P_CLIP_LEFT[r0]
                li r1, 1
                st r1, V_EP_FLAGS[r0]           ; no video map
                st r1, O_EP_FLAGS[r0]
                jmp S_MPS
SNIFF_BARE_E:   li r1, E_BARE
                jmp ERR
SNIFF_IMG:      ld r1, V_TOTAL[r0]
                bgeui r1, 17, SNIFF_VD
                li r1, E_SMALL
                jmp ERR
SNIFF_VD:       li r1, ST_WALK
                st r1, O_STATE[r0]
                li r1, 16
                st r1, V_VD_LBA[r0]

; S_VD: volume descriptors from LBA 16 to the first primary one
S_VD:           ld r1, V_VD_LBA[r0]
                call SETDIR
                lbf r2, 0[r0], 1                ; vd_type
                lbf r3, 1[r0], 4
                li r4, 0x43443030               ; "CD00"
                seq r3, r3, r4
                lbf r4, 5[r0], 1
                seq r4, r4, 0x31               ; "1"
                and r3, r3, r4                  ; cd001
                beqi r3, 0, VD_NOT
                beqi r2, 1, S_VD_ROOT
                beqi r2, 255, VD_NOT
                ld r1, V_VD_LBA[r0]
                add r1, r1, 1
                ld r2, V_TOTAL[r0]
                bgeu r1, r2, VD_NOT
                st r1, V_VD_LBA[r0]
                jmp S_VD
VD_NOT:         li r1, E_NOT_ISO
                jmp ERR

S_VD_ROOT:      lbl r1, 158[r0], 4              ; the root record at 156: extent, length
                st r1, V_FD_LBA[r0]
                lbl r1, 166[r0], 4
                st r1, V_FD_LEN[r0]
                li r1, 0x554D445F               ; "UMD_VIDEO"
                li r2, 0x56494445
                li r3, 0x4F000000
                li r4, 9
                li r5, 1
                call SETNAME
                call FIND
; S_UV
                ld r1, V_FD_FOUND[r0]
                bnei r1, 0, UV_OK
                li r1, E_NO_UMDV
                jmp ERR
UV_OK:          ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                st r1, V_UV_LBA[r0]
                st r2, V_UV_LEN[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x50415241               ; "PARAM.SFO"
                li r2, 0x4D2E5346
                li r3, 0x4F000000
                li r4, 9
                li r5, 0
                call SETNAME
                call FIND

; ---- PARAM.SFO: TITLE by key; any problem here only costs the title -------------------------------
S_SFO_OPEN:     ld r1, V_FD_FOUND[r0]
                beqi r1, 0, SFO_WARN
                ld r1, V_FD_FLAGS[r0]
                and r1, r1, 128
                bnei r1, 0, SFO_WARN
                li r1, FILE_SFO
                st r1, V_CUR_FILE[r0]
                ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                call SETFILE
                bgeu r0, r15, S_OOB             ; fo_off 0
                lbf r1, 0[r0], 4
                li r2, 0x00505346               ; "\0PSF"
                bne r1, r2, SFO_WARN
                lbl r1, 8[r0], 4
                st r1, V_SFO_KOFF[r0]
                lbl r1, 12[r0], 4
                st r1, V_SFO_DOFF[r0]
                lbl r1, 16[r0], 4
                st r1, V_SFO_N[r0]
                st r0, V_SFO_I[r0]
S_SFO_ENT:      ld r1, V_SFO_I[r0]
                ld r2, V_SFO_N[r0]
                beq r1, r2, SFO_WARN            ; no TITLE key
                shr r3, r1, 28
                bnei r3, 0, S_OOB
                shl r10, r1, 4
                add r10, r10, 20
                bgeu r10, r15, S_OOB
                lbl r1, 4[r10], 4
                st r1, V_TC_K[r0]               ; (sfo_used, for now)
                lbl r1, 12[r10], 4
                st r1, V_SFO_DO[r0]
                lbl r1, 0[r10], 2
                ld r2, V_SFO_KOFF[r0]
                add r10, r2, r1
                bgeu r10, r15, S_OOB
                lbf r1, 0[r10], 4               ; key_title: "TITLE\0"
                li r2, 0x5449544C
                bne r1, r2, SFO_NEXT
                lbf r1, 4[r10], 2
                li r2, 0x4500
                bne r1, r2, SFO_NEXT
                ; the TITLE: its length, kept to 128 (title_trunc)
                ld r1, V_TC_K[r0]               ; sfo_used
                li r2, 128
                bgeu r2, r1, SFO_LEN
                ld r3, V_FLAGS[r0]
                or r3, r3, FL_TRUNC
                st r3, V_FLAGS[r0]
                st r3, O_FLAGS[r0]
                mov r1, r2
SFO_LEN:        st r1, V_TLEN_OUT[r0]
                st r1, O_TITLE_LEN[r0]
                beqi r1, 0, S_PL_FIND
                st r0, V_TC_K[r0]
; S_TCOPY: a fetch's bounds check at every 32nd byte, as the RTL fetches
S_TCOPY:        ld r1, V_TC_K[r0]
                ld r2, V_TLEN_OUT[r0]
                beq r1, r2, S_PL_FIND
                ld r3, V_SFO_DOFF[r0]
                ld r4, V_SFO_DO[r0]
                add r10, r3, r4
                add r10, r10, r1
                and r5, r1, 31
                bnei r5, 0, TC_BYTE
                bgeu r10, r15, S_OOB
TC_BYTE:        lbf r5, 0[r10], 1
                st r5, O_TITLE_MEM[r1]
                add r1, r1, 1
                st r1, V_TC_K[r0]
                jmp S_TCOPY
SFO_NEXT:       ld r1, V_SFO_I[r0]
                add r1, r1, 1
                st r1, V_SFO_I[r0]
                jmp S_SFO_ENT
SFO_WARN:       ld r1, V_FLAGS[r0]
                or r1, r1, FL_SFO_WARN
                st r1, V_FLAGS[r0]
                st r1, O_FLAGS[r0]

; ---- PLAYLIST.UMD: the longest playlist ---------------------------------------------------------
S_PL_FIND:      ld r1, V_UV_LBA[r0]
                ld r2, V_UV_LEN[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x504C4159               ; "PLAYLIST.UMD"
                li r2, 0x4C495354
                li r3, 0x2E554D44
                li r4, 12
                li r5, 0
                call SETNAME
                call FIND
; S_PL_OPEN
                ld r1, V_FD_FOUND[r0]
                bnei r1, 0, PLO_1
                li r1, E_NO_PL
                jmp ERR
PLO_1:          ld r1, V_FD_FLAGS[r0]
                and r1, r1, 128
                beqi r1, 0, PLO_2
                li r1, E_EXTENT
                jmp ERR
PLO_2:          ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                st r1, V_PL_LBA[r0]
                st r2, V_PL_SIZE[r0]
PL_REREAD:      li r1, FILE_PL
                st r1, V_CUR_FILE[r0]
                ld r1, V_PL_LBA[r0]
                ld r2, V_PL_SIZE[r0]
                call SETFILE
                bgeu r0, r15, S_OOB
; S_PL_HDR
                lbf r1, 0[r0], 4
                li r2, 0x554D4456               ; "UMDV0088"
                bne r1, r2, PLH_BAD
                lbf r1, 4[r0], 4
                li r2, 0x30303838
                beq r1, r2, PLH_OK
PLH_BAD:        li r1, E_NO_PL
                jmp ERR
PLH_OK:         lbf r10, 8[r0], 4               ; playlists_off
                bgeu r10, r15, S_OOB
; S_PL_LIST
                lbf r1, 4[r10], 2
                st r1, V_N_PL[r0]
                st r1, O_N_PLAYLISTS[r0]
                st r0, V_PL_K[r0]
                add r10, r10, 6
                st r10, V_PL_P[r0]
                st r0, V_BEST_VALID[r0]
S_PL_ENT:       ld r1, V_PL_K[r0]
                ld r2, V_N_PL[r0]
                beq r1, r2, PL_END
                ld r10, V_PL_P[r0]
                bgeu r10, r15, S_OOB
; S_PL_ENT2
                lbf r1, 0[r10], 4
                add r2, r10, 4                  ; p_plus, 33 bits
                add r2, r2, r1
                bcs E_PL_
                st r2, V_PL_NEXT[r0]
                lbf r1, 6[r10], 2               ; the marks section
                add r2, r10, r1
                st r2, V_PL_MK[r0]
                li r3, 0
                bcc PLE_MK
                li r3, 1
PLE_MK:         st r3, V_PL_MK_C[r0]
                lbf r1, 4[r10], 2               ; the items section
                add r10, r10, r1
                bgeu r10, r15, S_OOB
; S_PL_ITEMS
                lbf r1, 4[r10], 4
                st r1, V_IT_N[r0]
                st r0, V_IT_J[r0]
                add r10, r10, 8
                st r10, V_IT_Q[r0]
                st r10, V_IT_Q0[r0]
                st r0, V_DUR_HI[r0]
                st r0, V_DUR_LO[r0]
S_PL_IT:        ld r1, V_IT_J[r0]
                ld r2, V_IT_N[r0]
                beq r1, r2, PL_CHOOSE
                ld r10, V_IT_Q[r0]
                call ITEM_REC                   ; -> r11 q_plus, the delta in V_IT_D*
; (dur_sum: 65 bits, saturating)
                ld r5, V_IT_DHI[r0]
                ld r6, V_IT_DLO[r0]
                ld r1, V_DUR_HI[r0]
                ld r2, V_DUR_LO[r0]
                add r2, r2, r6
                adc r1, r1, r5
                bcc PLI_ST
                li r1, 0xFFFFFFFF
                li r2, 0xFFFFFFFF
                ld r3, V_FLAGS[r0]
                or r3, r3, FL_DUR_SAT
                st r3, V_FLAGS[r0]
                st r3, O_FLAGS[r0]
PLI_ST:         st r1, V_DUR_HI[r0]
                st r2, V_DUR_LO[r0]
                st r11, V_IT_Q[r0]
                ld r1, V_IT_J[r0]
                add r1, r1, 1
                st r1, V_IT_J[r0]
                jmp S_PL_IT
PL_CHOOSE:      ld r1, V_PL_FORCE[r0]
                beqi r1, 0, PLC_LONG
                ld r1, V_PL_K[r0]
                ld r2, V_PL_FK[r0]
                bne r1, r2, PLC_SKIP
                jmp PLC_TAKE
PLC_LONG:       ld r1, V_BEST_VALID[r0]
                beqi r1, 0, PLC_TAKE
                ld r1, V_BEST_DUR_HI[r0]        ; dur > best_dur
                ld r2, V_BEST_DUR_LO[r0]
                ld r3, V_DUR_HI[r0]
                ld r4, V_DUR_LO[r0]
                sub r5, r2, r4
                sbc r5, r1, r3
                bcc PLC_SKIP
PLC_TAKE:       li r1, 1
                st r1, V_BEST_VALID[r0]
                ld r1, V_DUR_HI[r0]
                ld r2, V_DUR_LO[r0]
                st r1, V_BEST_DUR_HI[r0]
                st r2, V_BEST_DUR_LO[r0]
                st r1, O_PL_DUR_HI[r0]
                st r2, O_PL_DUR_LO[r0]
                ld r1, V_IT_Q0[r0]
                st r1, V_BEST_Q[r0]
                ld r1, V_IT_N[r0]
                st r1, V_BEST_N[r0]
                st r1, O_ACC_ITEMS[r0]
                ld r1, V_PL_MK[r0]
                st r1, V_BEST_MK[r0]
                ld r1, V_PL_MK_C[r0]
                st r1, V_BEST_MK_C[r0]
                ld r1, V_PL_K[r0]
                st r1, O_MAIN_PL[r0]
PLC_SKIP:       ld r1, V_PL_K[r0]
                add r1, r1, 1
                st r1, V_PL_K[r0]
                ld r1, V_PL_NEXT[r0]
                st r1, V_PL_P[r0]
                jmp S_PL_ENT
PL_END:         ld r1, V_BEST_VALID[r0]
                beqi r1, 0, E_PL_               ; no playlists
                ld r1, V_PL_FORCE[r0]
                beqi r1, 0, PLE_ITEMS
                ld r1, V_SK_ACT[r0]
                beqi r1, 0, PLE_ITEMS
                ; NAV_PLAY: land on (item, pts) as a seek does; an item past the playlist's last
                ; plays it from its first, at IN (flagged)
                st r0, V_IT_J[r0]
                ld r1, V_BEST_Q[r0]
                st r1, V_IT_Q[r0]
                st r0, V_BASE_HI[r0]
                st r0, V_BASE_LO[r0]
                ld r2, V_BEST_N[r0]
                st r2, O_N_ITEMS[r0]
                ld r1, V_SK_ITEM[r0]
                bltu r1, r2, S_SK_IT
                st r0, V_SK_ITEM[r0]
                st r0, V_SK_HI[r0]
                st r0, V_SK_LO[r0]
                li r1, NE_ITEM
                st r1, V_NAV_ERR[r0]
                st r1, O_NAV_ERR[r0]
                jmp S_SK_IT
PLE_ITEMS:      ld r1, V_BEST_Q[r0]
                st r1, V_ITEM_Q[r0]
                st r0, V_ITEM_IDX[r0]
                st r0, O_ITEM_IDX[r0]
                st r0, V_BASE_HI[r0]
                st r0, V_BASE_LO[r0]
                jmp S_ITEM

; ITEM_REC: the item record at r10 of PLAYLIST.UMD (the current file): its length checked
; (u32 >= 22, the sum's carry), r11 = q_plus, V_IT_D* = OUT - IN; IN / OUT in r1:r2 / r3:r4
ITEM_REC:       bgeu r10, r15, S_OOB
                lbf r1, 0[r10], 4
                bltui r1, 22, E_PL_
                add r11, r10, 4
                add r11, r11, r1
                bcs E_PL_
                lbf r1, 14[r10], 2
                lbf r2, 16[r10], 4
                lbf r3, 20[r10], 2
                lbf r4, 22[r10], 4
                call DELTA48
                st r5, V_IT_DHI[r0]
                st r6, V_IT_DLO[r0]
                ret

; ---- the chosen playlist's items, in order ------------------------------------------------------
S_ITEM:         li r1, ST_ITEM
                st r1, O_STATE[r0]
                ld r1, V_ITEM_IDX[r0]
                ld r2, V_BEST_N[r0]
                bne r1, r2, ITEM_GO
                ld r3, V_SK_ACT[r0]             ; NAV_PLAY of a playlist with no item: it lands
                beqi r3, 0, ITEM_END            ; on its end, nothing streamed (NE_ITEM)
                st r1, O_NAV_LAND[r0]
                st r0, V_SK_ACT[r0]
                st r0, O_NAV_DONE[r0]
ITEM_END:       st r0, V_STREAMING[r0]
                st r0, O_STREAMING[r0]
                jmp S_DRAIN
ITEM_GO:        wait ST_NOHOLD                  ; P6b3i: never start the next item under item_hold
                li r1, ST_ITEM2
                st r1, O_STATE[r0]              ; (the hardware ignores it while item_hold is up)
                ld r2, I_STATE[r0]
                bne r1, r2, ITEM_GO
                li r1, FILE_PL
                st r1, V_CUR_FILE[r0]
                ld r1, V_PL_LBA[r0]
                ld r2, V_PL_SIZE[r0]
                call SETFILE
                ld r10, V_ITEM_Q[r0]
                bgeu r10, r15, S_OOB
; S_ITEM2
                lbf r1, 0[r10], 4
                lbf r2, 4[r10], 2               ; the clip name's length
                bltui r1, 22, E_PL_
                beqi r2, 0, E_PL_
                bltui r2, 9, IT2_1
                jmp E_PL_
IT2_1:          add r3, r10, 4
                add r3, r3, r1
                bcs E_PL_
                st r3, V_ITEM_NEXT[r0]
                and r2, r2, 15
                st r2, V_CL_LEN[r0]
                li r3, 0
IT2_CN:         add r4, r10, r3
                lbf r5, 6[r4], 1
                st r5, V_CN[r3]
                add r3, r3, 1
                bnei r3, 8, IT2_CN
                lbf r1, 6[r10], 4
                st r1, O_CLIP_NAME_HI[r0]
                lbf r1, 10[r10], 4
                st r1, O_CLIP_NAME_LO[r0]
                lbf r1, 14[r10], 2
                lbf r2, 16[r10], 4
                lbf r3, 20[r10], 2
                lbf r4, 22[r10], 4
                st r1, V_IN_HI[r0]
                st r2, V_IN_LO[r0]
                st r3, V_OUT_HI[r0]
                st r4, V_OUT_LO[r0]
                st r1, O_ITEM_IN_HI[r0]
                st r2, O_ITEM_IN_LO[r0]
                st r3, O_ITEM_OUT_HI[r0]
                st r4, O_ITEM_OUT_LO[r0]
                call DELTA48
                ld r7, V_BASE_HI[r0]            ; item_base = base_acc, then base_acc += delta
                ld r8, V_BASE_LO[r0]
                st r7, O_ITEM_BASE_HI[r0]
                st r8, O_ITEM_BASE_LO[r0]
                call BASE_ADD
                ld r1, V_BEST_N[r0]
                st r1, O_N_ITEMS[r0]
                ld r1, V_ITEM_IDX[r0]
                st r1, O_ITEM_IDX[r0]
                ; CLIPINF/
                ld r1, V_UV_LBA[r0]
                ld r2, V_UV_LEN[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x434C4950               ; "CLIPINF"
                li r2, 0x494E4600
                li r3, 0
                li r4, 7
                li r5, 1
                call SETNAME
                call FIND
; S_CI
                ld r1, V_FD_FOUND[r0]
                beqi r1, 0, E_NO_CLP_
                ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x434C50                 ; ".CLP"
                call CLIPNAME
                call FIND

; ---- CLIPINF/<clip>.CLP: the stream table ----------------------------------------------------------
; S_CLP_OPEN
                ld r1, V_FD_FOUND[r0]
                beqi r1, 0, E_NO_CLP_
                ld r1, V_FD_FLAGS[r0]
                and r1, r1, 128
                beqi r1, 0, CLPO_1
                li r1, E_EXTENT
                jmp ERR
CLPO_1:         li r1, FILE_CLP
                st r1, V_CUR_FILE[r0]
                ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                call SETFILE
                bgeu r0, r15, S_OOB
; S_CLP_HDR
                lbf r1, 0[r0], 4
                li r2, 0x434C5049               ; "CLPI0088"
                bne r1, r2, E_CLP_
                lbf r1, 4[r0], 4
                li r2, 0x30303838
                bne r1, r2, E_CLP_
                lbf r10, 8[r0], 4
                st r10, V_SI_OFF[r0]
                lbf r1, 12[r0], 4
                st r1, V_EPMAP[r0]
                st r1, O_EP_MAP_OFF[r0]
                bgeu r10, r15, S_OOB
; S_CLP_SI: u32 len, u48 start, u48 end, u16 n; len must be 14 + 14 n
                lbf r1, 0[r10], 4
                lbf r2, 16[r10], 2
                shl r3, r2, 4
                shl r4, r2, 1
                sub r3, r3, r4
                add r3, r3, 14
                bne r1, r3, E_CLP_
                st r2, V_ST_N[r0]
                st r2, O_N_STREAMS[r0]
                lbf r1, 4[r10], 2
                st r1, O_CLIP_START_HI[r0]
                lbf r1, 6[r10], 4
                st r1, O_CLIP_START_LO[r0]
                lbf r1, 10[r10], 2
                st r1, O_CLIP_END_HI[r0]
                lbf r1, 12[r10], 4
                st r1, O_CLIP_END_LO[r0]
                st r0, V_NVID[r0]
                st r0, V_NUNK[r0]
                st r0, V_AUD[r0]
                st r0, V_SUB[r0]
                st r0, V_VATTR[r0]
                st r0, O_N_VIDEO[r0]
                st r0, O_N_UNKNOWN[r0]
                st r0, O_AUD_PRESENT[r0]
                st r0, O_SUB_PRESENT[r0]
                st r0, O_VID_ATTR[r0]
                st r0, V_ST_I[r0]
                add r10, r10, 18
                st r10, V_ST_O[r0]
S_CLP_ST:       ld r1, V_ST_I[r0]
                ld r2, V_ST_N[r0]
                beq r1, r2, S_EP
                ld r10, V_ST_O[r0]
                bgeu r10, r15, S_OOB
; S_CLP_ST2: u8 stream_id, u8 substream_id, ..., attr[8] at +6
                lbf r1, 0[r10], 1
                lbf r2, 1[r10], 1
                bnei r1, 0xE0, ST_AUD
                ld r3, V_NVID[r0]
                bnei r3, 0, ST_V2
                lbf r4, 6[r10], 1
                lbf r5, 7[r10], 1
                shl r5, r5, 8
                or r4, r4, r5
                st r4, V_VATTR[r0]
                st r4, O_VID_ATTR[r0]
ST_V2:          add r3, r3, 1
                st r3, V_NVID[r0]
                st r3, O_N_VIDEO[r0]
                jmp ST_NEXT
ST_AUD:         bnei r1, 0xBD, ST_UNK
                shr r3, r2, 4
                bnei r3, 0, ST_SUB
                and r3, r2, 15                  ; audio 0x00-0x0F
                li r4, 1
                shl r4, r4, r3
                ld r5, V_AUD[r0]
                or r5, r5, r4
                st r5, V_AUD[r0]
                st r5, O_AUD_PRESENT[r0]
                lbf r4, 8[r10], 2
                st r4, O_LANG_MEM[r3]
                jmp ST_NEXT
ST_SUB:         shr r3, r2, 5
                bnei r3, 4, ST_UNK
                and r3, r2, 31                  ; subtitles 0x80-0x9F
                li r4, 1
                shl r4, r4, r3
                ld r5, V_SUB[r0]
                or r5, r5, r4
                st r5, V_SUB[r0]
                st r5, O_SUB_PRESENT[r0]
                lbf r4, 8[r10], 2
                st r4, O_LANG_MEM+16[r3]
                jmp ST_NEXT
ST_UNK:         ld r3, V_NUNK[r0]
                add r3, r3, 1
                st r3, V_NUNK[r0]
                st r3, O_N_UNKNOWN[r0]
ST_NEXT:        ld r1, V_ST_I[r0]
                add r1, r1, 1
                st r1, V_ST_I[r0]
                ld r1, V_ST_O[r0]
                add r1, r1, 14
                st r1, V_ST_O[r0]
                jmp S_CLP_ST

; ---- the EP map: where the item starts and stops (P6b2) --------------------------------------------
; LK_T: lk_start_t -> V_T: IN, or a seek's target clamped into [IN, OUT - 4]
; (umd_nav_ref.Title.clamp; END_GUARD = 4, fix/skip-last-picture)
LK_T:           ld r1, V_IN_HI[r0]
                ld r2, V_IN_LO[r0]
                ld r3, V_SK_ACT[r0]
                beqi r3, 0, LKT_ST
                ld r3, V_OUT_HI[r0]             ; out_mk = OUT < 4 ? 0 : OUT - 4
                ld r4, V_OUT_LO[r0]
                sub r4, r4, 4
                sbc r3, r3, r0
                bcc LKT_1
                li r3, 0
                li r4, 0
LKT_1:          ld r5, V_SK_HI[r0]              ; sk_t1 = sk_pts > out_mk ? out_mk : sk_pts
                ld r6, V_SK_LO[r0]
                sub r7, r4, r6
                sbc r7, r3, r5
                bcs LKT_2
                mov r3, r5
                mov r4, r6
LKT_2:          sub r7, r4, r2                  ; sk_t1 < IN ? IN : sk_t1
                sbc r7, r3, r1
                bcs LKT_ST
                mov r1, r3
                mov r2, r4
LKT_ST:         st r1, V_T_HI[r0]
                st r2, V_T_LO[r0]
                ret

; EPADDR: r1 = an entry index -> r2 = vm_base + 10 r1 (its low 32 bits), r3 = the bits above
EPADDR:         ld r2, V_VM_LO[r0]
                ld r3, V_VM_C[r0]
                shl r4, r1, 3
                add r2, r2, r4
                adc r3, r3, r0
                shr r4, r1, 29
                add r3, r3, r4
                shl r4, r1, 1
                add r2, r2, r4
                adc r3, r3, r0
                shr r4, r1, 31
                add r3, r3, r4
                ret

S_EP:           st r0, V_EP_FLAGS[r0]
                st r0, O_EP_FLAGS[r0]
                st r0, V_STOP_V[r0]
                call LK_T
                st r1, O_NAV_SKIP_HI[r0]
                st r2, O_NAV_SKIP_LO[r0]
                ld r10, V_EPMAP[r0]
                bgeu r10, r15, S_OOB
; S_EP_HDR
                lbf r1, 6[r10], 2
                st r1, V_EP_NM[r0]
                st r0, V_EP_MI[r0]
S_EP_MAP:       ld r1, V_EP_MI[r0]
                ld r2, V_EP_NM[r0]
                beq r1, r2, EP_NOMAP
                ld r10, V_EPMAP[r0]             ; map_addr = ep_map_off + 8 + 10 ep_mi, 33 bits
                add r10, r10, 8
                li r3, 0
                adc r3, r3, r0
                shl r4, r1, 3
                add r10, r10, r4
                adc r3, r3, r0
                shl r4, r1, 1
                add r10, r10, r4
                adc r3, r3, r0
                bnei r3, 0, S_OOB
                bgeu r10, r15, S_OOB
; S_EP_MAP2
                lbf r1, 0[r10], 1
                bnei r1, 0xE0, EPM_NEXT
                lbf r1, 2[r10], 4
                st r1, V_VM_N[r0]
                lbf r1, 6[r10], 4               ; vm_base = ep_map_off + 6 + off, 33 bits
                ld r2, V_EPMAP[r0]
                add r2, r2, 6
                li r3, 0
                adc r3, r3, r0
                add r2, r2, r1
                adc r3, r3, r0
                st r2, V_VM_LO[r0]
                st r3, V_VM_C[r0]
                jmp S_EP_CHK
EPM_NEXT:       ld r1, V_EP_MI[r0]
                add r1, r1, 1
                st r1, V_EP_MI[r0]
                jmp S_EP_MAP
EP_NOMAP:       li r1, 1                        ; no video map: the clip streams whole from 0
                st r1, V_EP_FLAGS[r0]
                st r1, O_EP_FLAGS[r0]
                st r0, V_EP_IDX[r0]
                st r0, V_EP_PTS[r0]
                st r0, V_EP_SEC[r0]
                st r0, O_NAV_EP_IDX[r0]
                st r0, O_NAV_EP_PTS[r0]
                st r0, O_NAV_EP_SEC[r0]
                jmp S_EP_DONE

; the map's last entry must end inside the CLP
S_EP_CHK:       ld r1, V_VM_N[r0]
                call EPADDR
                bnei r3, 0, S_OOB
                bltu r15, r2, S_OOB             ; ep_addr > f_size
                ld r1, V_VM_N[r0]
                beqi r1, 0, EP_NOMAP            ; an empty video map: as none
                st r0, V_LK_STOP[r0]
                st r0, V_LK_LO[r0]
                st r1, V_LK_HI[r0]
                ld r1, V_T_HI[r0]
                beqi r1, 0, S_LK
                li r1, 4                        ; a target >= 2^32
                st r1, V_EP_FLAGS[r0]
                st r1, O_EP_FLAGS[r0]

; binary search: lk_lo = how many entries are <= t (the start) or < t (the stop)
S_LK:           ld r1, V_LK_LO[r0]
                ld r2, V_LK_HI[r0]
                beq r1, r2, S_LK_END
                sub r12, r2, r1
                shr r12, r12, 1
                add r12, r12, r1                ; lk_mid
                mov r1, r12
                call EPADDR
                mov r10, r2
                bgeu r10, r15, S_OOB
; S_LK2
                lbf r5, 2[r10], 4               ; the entry's PTS
                ld r1, V_LK_STOP[r0]
                bnei r1, 0, LK2_STOP
                ld r3, V_T_HI[r0]               ; start: right while entry <= t
                ld r4, V_T_LO[r0]
                sub r6, r4, r5
                sbc r6, r3, r0                  ; C: t < entry
                bcs LK2_LEFT
                jmp LK2_RIGHT
LK2_STOP:       ld r3, V_OUT_HI[r0]             ; stop: right while entry < OUT
                ld r4, V_OUT_LO[r0]
                sub r6, r5, r4
                sbc r6, r0, r3                  ; C: entry < OUT
                bcc LK2_LEFT
LK2_RIGHT:      add r1, r12, 1
                st r1, V_LK_LO[r0]
                jmp S_LK
LK2_LEFT:       st r12, V_LK_HI[r0]
                jmp S_LK

S_LK_END:       ld r1, V_LK_LO[r0]
                ld r2, V_LK_STOP[r0]
                beqi r2, 0, LKE_START
                ld r3, V_VM_N[r0]
                beq r1, r3, S_EP_DONE           ; no entry at or after OUT: the clip's end
                jmp LKE_GET
LKE_START:      beqi r1, 0, LKE_GET             ; the last entry <= t, the first for an earlier t
                sub r1, r1, 1
; S_LK_GET / S_LK_ENT
LKE_GET:        st r1, V_LK_IDX[r0]
                call EPADDR
                mov r10, r2
                bgeu r10, r15, S_OOB
                ld r1, V_LK_STOP[r0]
                bnei r1, 0, LKE_STOP
                ld r1, V_LK_IDX[r0]
                st r1, V_EP_IDX[r0]
                st r1, O_NAV_EP_IDX[r0]
                lbf r1, 2[r10], 4
                st r1, V_EP_PTS[r0]
                st r1, O_NAV_EP_PTS[r0]
                lbf r1, 6[r10], 4
                st r1, V_EP_SEC[r0]
                st r1, O_NAV_EP_SEC[r0]
                li r1, 1                        ; the stop: the first entry at or after OUT
                st r1, V_LK_STOP[r0]
                st r0, V_LK_LO[r0]
                ld r1, V_VM_N[r0]
                st r1, V_LK_HI[r0]
                ld r1, V_OUT_HI[r0]
                beqi r1, 0, S_LK
                ld r1, V_EP_FLAGS[r0]
                or r1, r1, 4
                st r1, V_EP_FLAGS[r0]
                st r1, O_EP_FLAGS[r0]
                jmp S_LK
LKE_STOP:       lbf r1, 6[r10], 4
                st r1, V_STOP_SEC[r0]
                li r1, 1
                st r1, V_STOP_V[r0]

S_EP_DONE:      ld r1, V_EP_SEC[r0]
                st r1, V_SK_SKIP[r0]
                ld r2, V_STOP_V[r0]
                st r2, V_CLIP_LIM[r0]
                st r2, P_CLIP_LIM[r0]
                li r3, 0
                beqi r2, 0, EPD_1
                ld r4, V_STOP_SEC[r0]
                bgeu r1, r4, EPD_1
                sub r3, r4, r1
EPD_1:          st r3, V_CLIP_LEFT[r0]
                st r3, P_CLIP_LEFT[r0]
                ; STREAM/
                ld r1, V_UV_LBA[r0]
                ld r2, V_UV_LEN[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x53545245               ; "STREAM"
                li r2, 0x414D0000
                li r3, 0
                li r4, 6
                li r5, 1
                call SETNAME
                call FIND
; S_ST
                ld r1, V_FD_FOUND[r0]
                bnei r1, 0, ST_OK
                li r1, E_NO_MPS
                jmp ERR
ST_OK:          ld r1, V_FD_EXT[r0]
                ld r2, V_FD_SIZE[r0]
                st r1, V_FD_LBA[r0]
                st r2, V_FD_LEN[r0]
                li r1, 0x4D5053                 ; ".MPS"
                call CLIPNAME
                call FIND

; ---- STREAM/<clip>.MPS: an extent record, the first or a continuation -------------------------------
S_MPS:          ld r1, V_FD_FOUND[r0]
                bnei r1, 0, MPS_1
                ld r1, V_STREAMING[r0]
                li r2, E_NO_MPS
                beqi r1, 0, MPS_E
                li r2, E_EXTENT
MPS_E:          mov r1, r2
                jmp ERR
MPS_1:          ld r1, V_STREAMING[r0]
                bnei r1, 0, MPS_2
                ld r1, V_FD_EXT[r0]
                st r1, O_MPS_LBA[r0]
                ld r1, V_FD_SIZE[r0]
                st r1, O_MPS_BYTES[r0]
                st r0, O_ITEM_START[r0]
MPS_2:          li r1, 1
                st r1, V_STREAMING[r0]
                st r1, O_STREAMING[r0]
                ld r2, V_FD_SIZE[r0]            ; fd_nsec: the extent's sectors (the last may be partial)
                shr r3, r2, 11
                and r4, r2, 2047
                sne r4, r4, r0
                add r3, r3, r4
                st r3, V_FD_NSEC[r0]
                ld r5, V_SK_SKIP[r0]
                bltu r5, r3, MPS_START
                ; the start lies beyond this extent: on to the next, or past the clip
                sub r5, r5, r3
                st r5, V_SK_SKIP[r0]
                ld r1, V_FD_FLAGS[r0]
                and r1, r1, 128
                bnei r1, 0, S_MPS_NEXT
                ld r6, V_EP_FLAGS[r0]
                or r7, r6, 2                    ; the entry lies past the clip: item skipped
                st r7, V_EP_FLAGS[r0]
                st r7, O_EP_FLAGS[r0]           ; (every result before nav_done's strobe)
                ld r1, V_SK_ACT[r0]
                beqi r1, 0, ITEM_ADV
                ld r2, V_NAV_ERR[r0]            ; (NAV_PLAY's NE_ITEM stands)
                beqi r2, NE_ITEM, MPS_PD
                li r2, NE_PAST
                and r3, r6, 1
                beqi r3, 0, MPS_PD
                li r2, NE_NOMAP
MPS_PD:         call NAV_LANDED
                jmp ITEM_ADV
MPS_START:      ld r1, V_SK_ACT[r0]
                beqi r1, 0, MPS_GO
                ld r2, V_NAV_ERR[r0]            ; a seek has landed
                beqi r2, NE_ITEM, MPS_LD
                ld r6, V_EP_FLAGS[r0]
                li r2, NE_NOMAP
                and r3, r6, 1
                bnei r3, 0, MPS_LD
                li r2, NE_WIDE
                and r3, r6, 4
                bnei r3, 0, MPS_LD
                li r2, NE_NONE
MPS_LD:         call NAV_LANDED
MPS_GO:         ld r1, V_FD_EXT[r0]
                ld r5, V_SK_SKIP[r0]
                add r1, r1, r5
                st r1, P_LBA[r0]
                ld r3, V_FD_NSEC[r0]
                sub r3, r3, r5
                st r3, P_LEFT[r0]
                st r0, V_SK_SKIP[r0]
                ld r1, V_ITEM_IDX[r0]
                and r1, r1, 3
                st r1, P_TAG[r0]
                li r1, PC_STREAM
                st r1, P_CMD[r0]
                jmp S_STREAM

; NAV_LANDED: r2 = nav_err: the seek / play / time has landed (nav_land = the item)
NAV_LANDED:     st r2, V_NAV_ERR[r0]
                st r2, O_NAV_ERR[r0]
                ld r1, V_ITEM_IDX[r0]
                st r1, O_NAV_LAND[r0]
                st r0, V_SK_ACT[r0]
                st r0, O_NAV_DONE[r0]
                ret

; multi-extent: resume the STREAM/ walk after this record (the same name)
S_MPS_NEXT:     call FIND_CONT
                jmp S_MPS

; the item is over: the next one
ITEM_ADV:       st r0, V_STREAMING[r0]
                st r0, O_STREAMING[r0]
                ld r1, V_ITEM_IDX[r0]
                add r1, r1, 1
                st r1, V_ITEM_IDX[r0]
                st r1, O_ITEM_IDX[r0]
                ld r1, V_ITEM_NEXT[r0]
                st r1, V_ITEM_Q[r0]
                jmp S_ITEM

; ---- streaming: the pump runs; the program waits for its stop or a command --------------------------
S_STREAM:       li r1, ST_STREAM
                st r1, O_STATE[r0]
                li r1, 1
                st r1, V_RET[r0]
STR_READY:      li r1, 1
                st r1, O_NAV_READY[r0]
STR_WAIT:       wait ST_PEND | ST_PUMP_IDLE
                st r0, O_NAV_READY[r0]          ; first: a take in this gap is still seen below
                ld r1, I_STATUS[r0]
                and r2, r1, ST_PEND
                bnei r2, 0, NAV
                ; the pump stopped: the item's stop, its clip's end, or an extent's end
                ld r1, V_CLIP_LIM[r0]
                beqi r1, 0, STR_2
                ld r1, I_P_CLIP_LEFT[r0]
                beqi r1, 0, ITEM_ADV
STR_2:          ld r1, V_FD_FLAGS[r0]
                and r1, r1, 128
                beqi r1, 0, ITEM_ADV
                jmp S_MPS_NEXT

S_DRAIN:        li r1, ST_DRAIN
                st r1, O_STATE[r0]
                li r1, 2
                st r1, V_RET[r0]
DR_READY:       li r1, 1
                st r1, O_NAV_READY[r0]
                wait ST_PEND | ST_EMPTY
                st r0, O_NAV_READY[r0]
                ld r1, I_STATUS[r0]
                and r2, r1, ST_PEND
                bnei r2, 0, NAV
                li r1, 1
                st r1, O_TITLE_DONE[r0]
S_DONE:         li r1, ST_DONE
                st r1, O_STATE[r0]
                li r1, 3
                st r1, V_RET[r0]
                li r1, 1
                st r1, O_NAV_READY[r0]
                wait ST_PEND
                jmp NAV

; back to where a command found the walk (a CHAP, a refusal)
NAV_RET:        ld r1, V_RET[r0]
                beqi r1, 2, DR_READY
                beqi r1, 3, S_DONE
                ld r1, V_PAUSED[r0]
                beqi r1, 0, STR_READY
                st r0, V_PAUSED[r0]
                li r1, PC_RESUME
                st r1, P_CMD[r0]
                jmp STR_READY

; ---- a navigation command (taken by the hardware: docs/nav_engine.md S7) ------------------------------
NAV:            ld r1, I_NAV_OP[r0]
                ld r2, I_STATUS[r0]
                and r2, r2, ST_ACCEPTED
                beqi r1, NAV_CHAP, S_MK
                beqi r1, NAV_SEEK, NAV_SK
                beqi r1, NAV_TIME, NAV_SK
                beqi r1, NAV_PLAY, NAV_SK
                li r1, NE_OP                    ; a reserved op: answered, nothing done
                jmp NAV_ANSWER
NAV_SK:         bnei r2, 0, NAV_TAKEN
                li r1, NE_ITEM                  ; refused: nothing flushed or changed
                ld r3, V_BARE[r0]
                beqi r3, 0, NAV_ANSWER
                li r1, NE_NOMAP                 ; P8: a bare stream has no map
NAV_ANSWER:     st r1, V_NAV_ERR[r0]
                st r1, O_NAV_ERR[r0]
                st r0, O_NAV_DONE[r0]
                jmp NAV_RET
NAV_TAKEN:      ; the hardware flushed at the edge (the cache, the output, streaming, title_done)
                st r0, O_NAV_READY[r0]
                st r0, V_STREAMING[r0]
                st r0, V_PAUSED[r0]
                li r3, 1
                st r3, V_SK_ACT[r0]
                ld r3, I_NAV_PTS_HI[r0]
                st r3, V_SK_HI[r0]
                ld r3, I_NAV_PTS_LO[r0]
                st r3, V_SK_LO[r0]
                ld r3, I_NAV_ITEM[r0]
                st r3, V_SK_ITEM[r0]
                st r0, V_NAV_ERR[r0]
                st r0, O_NAV_ERR[r0]
                beqi r1, NAV_PLAY, NAV_PLAYL
                seq r3, r1, NAV_TIME
                st r3, V_SK_TM[r0]
                st r0, V_IT_J[r0]
                ld r3, V_BEST_Q[r0]
                st r3, V_IT_Q[r0]
                st r0, V_BASE_HI[r0]
                st r0, V_BASE_LO[r0]
                jmp S_SK_IT
NAV_PLAYL:      st r0, V_SK_TM[r0]
                li r3, 1
                st r3, V_PL_FORCE[r0]
                ld r3, I_NAV_PL[r0]
                st r3, V_PL_FK[r0]
                li r1, ST_WALK
                st r1, O_STATE[r0]
                jmp PL_REREAD

; NAV_SEEK / NAV_TIME: walk the item records to the target (they are variable-length);
; NAV_TIME subtracts each record's span from the time until the item that holds it
S_SK_IT:        li r1, ST_WALK
                st r1, O_STATE[r0]
                ld r1, V_SK_TM[r0]
                bnei r1, 0, SK_READ
                ld r1, V_IT_J[r0]
                ld r2, V_SK_ITEM[r0]
                bne r1, r2, SK_READ
                ld r1, V_IT_Q[r0]
                st r1, V_ITEM_Q[r0]
                st r2, V_ITEM_IDX[r0]
                jmp S_ITEM
SK_READ:        li r1, FILE_PL
                st r1, V_CUR_FILE[r0]
                ld r1, V_PL_LBA[r0]
                ld r2, V_PL_SIZE[r0]
                call SETFILE
                ld r10, V_IT_Q[r0]
                call ITEM_REC                   ; -> r11 q_plus; r1:r2 IN, r3:r4 OUT; the delta
; S_SK_IT2
                ld r5, V_SK_TM[r0]
                beqi r5, 0, SK_PASS
                ld r5, V_IT_DHI[r0]             ; tm_left = sk_pts - delta (49 bits; its borrow: here)
                ld r6, V_IT_DLO[r0]
                ld r7, V_SK_HI[r0]
                ld r8, V_SK_LO[r0]
                sub r8, r8, r6
                sbc r7, r7, r5
                bcs SK_HERE
                ld r9, V_IT_J[r0]
                add r9, r9, 1
                ld r12, V_BEST_N[r0]
                beq r9, r12, SK_LAST
                and r7, r7, 0xFFFF
                st r7, V_SK_HI[r0]
                st r8, V_SK_LO[r0]
                jmp SK_PASS
SK_HERE:        ld r7, V_SK_HI[r0]              ; start it at IN + the time left
                ld r8, V_SK_LO[r0]
                add r8, r8, r2
                adc r7, r7, r1
                and r7, r7, 0xFFFF
                jmp SK_LAND
SK_LAST:        mov r7, r3                      ; past the end: the last item, at its OUT
                mov r8, r4
SK_LAND:        st r7, V_SK_HI[r0]
                st r8, V_SK_LO[r0]
                st r0, V_SK_TM[r0]
                ld r1, V_IT_Q[r0]
                st r1, V_ITEM_Q[r0]
                ld r1, V_IT_J[r0]
                st r1, V_ITEM_IDX[r0]
                jmp S_ITEM
SK_PASS:        st r11, V_IT_Q[r0]
                ld r1, V_IT_J[r0]
                add r1, r1, 1
                st r1, V_IT_J[r0]
                ld r5, V_IT_DHI[r0]             ; P6b5: an item the seek passes
                ld r6, V_IT_DLO[r0]
                call BASE_ADD
                jmp S_SK_IT

; ---- NAV_CHAP: one pass over the main playlist's marks ----------------------------------------------
; A mark is a chapter when its type is 5 and its item exists; the last two at or before the key
; are kept as a multiset, the first after it as next (umd_nav_ref.Title.chapters).
S_MK:           ld r1, V_RET[r0]                ; served between stream sectors
                bnei r1, 1, MK_0
                li r1, PC_PAUSE
                st r1, P_CMD[r0]
                li r1, 1
                st r1, V_PAUSED[r0]
                wait ST_PUMP_IDLE
MK_0:           ld r1, I_NAV_ITEM[r0]           ; q_key1 = the key + 1, the item saturated to u16
                shr r2, r1, 16
                beqi r2, 0, MK_Q
                li r2, 1
                st r2, V_Q2[r0]
                st r0, V_QHI[r0]
                st r0, V_QLO[r0]
                jmp MK_1
MK_Q:           ld r3, I_NAV_PTS_HI[r0]
                ld r4, I_NAV_PTS_LO[r0]
                and r3, r3, 0xFFFF
                shl r1, r1, 16
                or r3, r3, r1
                add r4, r4, 1
                adc r3, r3, r0
                li r2, 0
                adc r2, r2, r0
                st r2, V_Q2[r0]
                st r3, V_QHI[r0]
                st r4, V_QLO[r0]
MK_1:           st r0, V_CH_RANK[r0]
                st r0, V_CH_COUNT[r0]
                st r0, V_CH_VALID[r0]
                st r0, V_NAV_ERR[r0]
                li r1, FILE_MRK
                st r1, V_CUR_FILE[r0]
                ld r1, V_BARE[r0]
                bnei r1, 0, S_NAV_END           ; P8: a bare stream has no chapter
                ld r1, V_PL_LBA[r0]
                ld r2, V_PL_SIZE[r0]
                call SETFILE
                ld r1, V_BEST_MK_C[r0]
                bnei r1, 0, S_OOB
                ld r10, V_BEST_MK[r0]
                bgeu r10, r15, S_OOB
; S_MK_HDR: u32 length, u16 n_marks: the length must hold exactly n marks
                lbf r1, 0[r10], 4
                lbf r2, 4[r10], 2
                shl r3, r2, 5
                shl r4, r2, 3
                add r3, r3, r4
                add r3, r3, 2
                beq r1, r3, MK_HDR_OK
                li r1, NE_MARKS
                st r1, V_NAV_ERR[r0]
                jmp S_NAV_END
MK_HDR_OK:      ; the scan keeps its loop in registers (a mark that is not a chapter costs ~9
                ; instructions): r9 = i, r13 = n, r10 = the mark's offset, r14 = its carry,
                ; r8 = best_n; the chapter bookkeeping lives in RAM
                mov r13, r2
                li r9, 0
                add r10, r10, 6
                li r14, 0
                adc r14, r14, r0
                ld r8, V_BEST_N[r0]
S_MK_ENT:       beq r9, r13, S_NAV_END
                bnei r14, 0, S_OOB
                bgeu r10, r15, S_OOB
; S_MK_ENT2: u8 type, u8 flags, u16 item, u48 PTS
                lbf r1, 0[r10], 1
                bnei r1, 5, MK_NEXT
                lbf r2, 2[r10], 2               ; the mark's item
                bgeu r2, r8, MK_NEXT            ; not a chapter: its item does not exist
                lbf r3, 4[r10], 2
                lbf r12, 6[r10], 4              ; the key: r11:r12 = {item, PTS}
                shl r11, r2, 16
                or r11, r11, r3
                ld r1, V_CH_COUNT[r0]
                add r1, r1, 1
                st r1, V_CH_COUNT[r0]
                ld r3, V_QHI[r0]                ; mark <= key: mark < key + 1 (65 bits)
                ld r4, V_QLO[r0]
                ld r5, V_Q2[r0]
                sub r6, r12, r4
                sbc r6, r11, r3
                sbc r6, r0, r5
                bcc MK_AFTER
                ld r1, V_CH_RANK[r0]
                add r1, r1, 1
                st r1, V_CH_RANK[r0]
                ld r7, V_CH_VALID[r0]
                and r1, r7, 1
                beqi r1, 0, MK_CUR
                ld r3, V_CUR_HI[r0]             ; mark >= cur: it becomes cur, cur becomes prev
                ld r4, V_CUR_LO[r0]
                sub r6, r12, r4
                sbc r6, r11, r3
                bcs MK_PREV
MK_CUR:         ld r3, V_CUR_HI[r0]
                ld r4, V_CUR_LO[r0]
                st r3, V_PREV_HI[r0]
                st r4, V_PREV_LO[r0]
                and r1, r7, 1                   ; prev valid = cur valid
                shl r1, r1, 1
                and r7, r7, 5
                or r7, r7, r1
                or r7, r7, 1
                st r7, V_CH_VALID[r0]
                st r11, V_CUR_HI[r0]
                st r12, V_CUR_LO[r0]
                jmp MK_NEXT
MK_PREV:        and r1, r7, 2
                beqi r1, 0, MK_SETPREV
                ld r3, V_PREV_HI[r0]            ; mark >= prev
                ld r4, V_PREV_LO[r0]
                sub r6, r12, r4
                sbc r6, r11, r3
                bcs MK_NEXT
MK_SETPREV:     st r11, V_PREV_HI[r0]
                st r12, V_PREV_LO[r0]
                or r7, r7, 2
                st r7, V_CH_VALID[r0]
                jmp MK_NEXT
MK_AFTER:       ld r7, V_CH_VALID[r0]           ; mark > key: next is the first such
                and r1, r7, 4
                beqi r1, 0, MK_SETNEXT
                ld r3, V_NEXT_HI[r0]
                ld r4, V_NEXT_LO[r0]
                sub r6, r12, r4
                sbc r6, r11, r3
                bcc MK_NEXT
MK_SETNEXT:     st r11, V_NEXT_HI[r0]
                st r12, V_NEXT_LO[r0]
                or r7, r7, 4
                st r7, V_CH_VALID[r0]
MK_NEXT:        add r9, r9, 1
                add r10, r10, 40
                adc r14, r14, r0
                jmp S_MK_ENT
MK_OOB:         li r1, NE_OOB
                st r1, V_NAV_ERR[r0]
S_NAV_END:      ld r1, V_CH_RANK[r0]
                st r1, O_CH_RANK[r0]
                ld r1, V_CH_COUNT[r0]
                st r1, O_CH_COUNT[r0]
                ld r1, V_CH_VALID[r0]
                st r1, O_CH_VALID[r0]
                ld r1, V_CUR_HI[r0]
                st r1, O_CH_CUR_HI[r0]
                ld r1, V_CUR_LO[r0]
                st r1, O_CH_CUR_LO[r0]
                ld r1, V_PREV_HI[r0]
                st r1, O_CH_PREV_HI[r0]
                ld r1, V_PREV_LO[r0]
                st r1, O_CH_PREV_LO[r0]
                ld r1, V_NEXT_HI[r0]
                st r1, O_CH_NEXT_HI[r0]
                ld r1, V_NEXT_LO[r0]
                st r1, O_CH_NEXT_LO[r0]
                ld r1, V_NAV_ERR[r0]
                st r1, O_NAV_ERR[r0]
                st r0, O_NAV_DONE[r0]
                jmp NAV_RET
